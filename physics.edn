;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; The README has no "Robotics premise" section; its Scope names the shop
;; this actor coordinates (ISIC 2512): welding and forming sheet/plate into
;; storage tanks, reservoirs, containers, gas cylinders and process vessels,
;; with a pressure-test rig. The physical work of that shop taken here:
;; filling a finished tank for its hydrostatic test, draining the test water
;; afterwards, and moving finished gas-cylinder shells off the line.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-2512"
 :cases
 [{:id :hydrotest-fill
   :kind :pipe-flow
   :procedure "fill a finished vertical tank with test water through a 100 mm hose from the shop main (60 m, 6 m rise to the top nozzle)"
   :params {:diameter-m 0.10 :length-m 60.0 :roughness-m 1.5e-5 :density-kg-m3 998.0
            :viscosity-pa-s 1.0e-3 :pump-efficiency 0.65 :elevation-m 6.0}
   :sweep {:param :q-m3s :values [0.005 0.010 0.015 0.020 0.030]}
   :quantity :pressure-drop-pa
   :limit {:max 400000.0 :basis "estimate: 4 bar available at the shop's water main"}
   :boundary {:lo 0.002 :hi 0.08}}
  {:id :hydrotest-drain
   :kind :tank-drain
   :procedure "after the hydrostatic test the robot opens the bottom drain and empties the 4 m-diameter tank from 6 m to 0.1 m"
   :params {:tank-area-m2 12.57 :h0-m 6.0 :h-target-m 0.1 :cd 0.62 :dt-s 1.0 :max-time-s 86400.0}
   :sweep {:param :orifice-area-m2 :values [0.001 0.002 0.004 0.008 0.012 0.018]}
   :quantity :time-to-target-s
   :limit {:max 14400.0 :basis "estimate: the test bay must be free within 4 hours for the next vessel"}
   :boundary {:lo 0.001 :hi 0.05}}
  {:id :cylinder-shell-offload
   :kind :manipulator
   :procedure "arm lifts a finished gas-cylinder shell off the final-weld station onto the paint-line hanger conveyor"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 14.0 :m2-kg 9.0
            :from [0.85 0.10] :to [0.40 0.95] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [8.0 15.0 20.0 30.0 45.0]}
   :quantity :peak-tau1-nm
   :limit {:max 500.0 :basis "estimate: continuous shoulder torque of a ~50 kg-payload handling arm class"}
   :boundary {:lo 1.0 :hi 120.0}}]}
